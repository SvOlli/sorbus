#!/bin/sh

cd "$(dirname "${0}")"
#   IS_RDY   [ label="data bus done" ]

dot -Tpng >"site/images/$(basename "${0}" .dot).png" <<EOF

digraph D {

   rankdir = TB;

   PREPARE_RDY_CHECK [ label="@30 +2\nprepare RDY check" ]
   PREPARE_RDY_CHECK -> CLK_LOW

   CLK_LOW           [ label="set CLK=0" ]
   CLK_LOW -> IS_RDY

   IS_RDY            [ shape=diamond label="@0 +1 (+3)\nis RDY set" ]
   IS_RDY -> IS_FIFO_TRIGGER [ label="+0\nRDY=1" ]
   IS_RDY -> NO_LOG [ label="+1\nRDY=0" ]

   IS_FIFO_TRIGGER   [ shape=diamond label="@1 +2\nFIFO marker in R6 set?" ]
   IS_FIFO_TRIGGER -> TRIGGER_FIFO [ label="+0\nr6 = 0" ]
   IS_FIFO_TRIGGER -> NO_FIFO_TRIGGER [ label="+1\nr6 ≠ 0" ]

   TRIGGER_FIFO      [ label="@3 +7\nwrite multicore fifo" ]
   TRIGGER_FIFO -> COUNTER_LOG

   NO_FIFO_TRIGGER   [ label="@4 +4\ndelay" ]
   NO_FIFO_TRIGGER -> COUNTER_LOG [ label="+2" ]

   COUNTER_LOG       [ label="@10 +14\ncounter & log" ]
   COUNTER_LOG -> DELAY_FINAL

   NO_LOG            [ label="@2 +20\ndelay" ]
   NO_LOG -> DELAY_FINAL [ label="+2" ]

   DELAY_FINAL       [ label="@24 +3\ndelay" ]
   DELAY_FINAL -> SELECT_RAM

   REG_5MEM          [ shape=rectangle label="R5=mem\nR9=romptr" ]
   REG_5MEM -> SELECT_RAM [ arrowhead=none ]

   SELECT_RAM        [ label="@27 +5\nset mem to RAM\nset romptr" ]
   SELECT_RAM -> CLK_HIGH

   CLK_HIGH          [ label="set CLK=1" ]
   CLK_HIGH -> GET_BUS_STATE

   INIT              [ shape=rectangle label="constants:\nR3=SIO_BANK\nR4=65C02 CLK\nR10=0xD000\nR11=0xDF00\nR12=0xE000" ]
   INIT -> LOOP_START [ arrowhead=none ]

   LOOP_START        [ shape=rectangle label="entry point" ]
   LOOP_START -> SELECT_RAM

   REG_0GPIO         [ shape=rectangle label="R0=GPIO\nR1=address\nR2=data\nR6=0xDF00\nR7=65C02 R/!W mask" ]
   REG_0GPIO -> GET_BUS_STATE [ arrowhead=none ]

   GET_BUS_STATE     [ label="@0 +9\nread GPIOs\nGPIO @ >= 6" ]
   GET_BUS_STATE -> IS_READ_WRITE;

   IS_READ_WRITE     [ shape=diamond label="@9 +2\ncheck read/write" ]
   IS_READ_WRITE -> IS_READ_DF00 [ label="+1\nread" ]
   IS_READ_WRITE -> IS_WRITE_D000 [ label="+0\nwrite" ]

   IS_READ_DF00      [ shape=diamond label="@12 +2\nread address < \$DF00?" ]
   IS_READ_DF00 -> IS_READ_D000 [ label="+1\n<\$DF00" ]
   IS_READ_DF00 -> IS_READ_E000 [ label="+0\n>=\$DF00" ]

   IS_READ_D000      [ shape=diamond label="@15 +2\nread address < \$D000?" ]
   IS_READ_D000 -> IS_READ_0004 [ label="+0\n<\$D000" ]
   IS_READ_D000 -> DELAY_R_D000 [ label="+1\n>=\$D000" ]

   IS_READ_0004      [ shape=diamond label="@17 +2\nread address < \$0004?" ]
   IS_READ_0004 -> PUT_DATA_ON_BUS [ label="+1\n>=\$0004" ]
   IS_READ_0004 -> DELAY_R_0004 [ label="+0\n<\$0004" ]

   DELAY_R_0004      [ label="@19 +7\ndelay" ]
   DELAY_R_0004 -> END_CLK_LOW [ label="+2" ]

   DELAY_R_D000      [ label="@18 +8\ndelay" ]
   DELAY_R_D000 -> END_CLK_LOW [ label="+2" ]

   IS_READ_E000      [ shape=diamond label="@14 +2\nread address < \$E000?" ]
   IS_READ_E000 -> IS_READ_DF10 [ label="+0\n<\$E000" ]
   IS_READ_E000 -> SELECT_ROM [ label="+1\n>=\$E000" ]

   IS_READ_DF10      [ shape=diamond label="@16 +3\nread address < \$DF10?\nR6=0xDF10" ]
   IS_READ_DF10 -> FIFO_FOR_READ [ label="+0\n<\$DF10" ]
   IS_READ_DF10 -> PUT_DATA_ON_BUS [ label="+1\n>=\$DF10" ]

   SELECT_ROM        [ label="@17 +1\nset mem to ROM" ]
   SELECT_ROM -> PUT_DATA_ON_BUS [ label="+2" ]

   IS_WRITE_D000     [ shape=diamond label="@11 +2\nwrite address < \$D000" ]
   IS_WRITE_D000 -> DELAY_W_D000 [ label="+1\n<\$D000" ]
   IS_WRITE_D000 -> IS_WRITE_DF00 [ label="+0\n>=\$D000" ]

   DELAY_W_D000      [ label="@14 +9\ndelay" ]
   DELAY_W_D000 -> WRITE_RAM [ label="+2" ]

   IS_WRITE_DF00     [ shape=diamond label="@13 +2\nwrite address >= \$DF00\n(1 cmp, 2 branches)" ]
   IS_WRITE_DF00 -> BANKSWITCH [ label="+0\n=\$DF00" ]
   IS_WRITE_DF00 -> DELAY_W__DF00 [ label="+2\n>\$DF00" ]

   DELAY_W__DF00     [ label="@17 +3\ndelay" ]
   DELAY_W__DF00 -> IS_WRITE_DF40

   IS_WRITE_DF40     [ shape=diamond label="@20 +3\nwrite address < \$DF40\nR6=0xDF40" ]
   IS_WRITE_DF40 -> DELAY_W_DF40 [ label="+0\n>=\$DF40" ]
   IS_WRITE_DF40 -> FIFO_FOR_WRITE [ label="+1\n<\$DF40" ]

   DELAY_W_DF40      [ label="@23" ]
   DELAY_W_DF40 -> WRITE_RAM [ label="+2" ]

   BANKSWITCH        [ label="@15 +9\nbankswitch\nuse of R6" ]
   BANKSWITCH -> FIFO_FOR_WRITE

   FIFO_FOR_WRITE    [ label="@24 +1\nmark fifo trigger\nR6=0" ]
   FIFO_FOR_WRITE -> WRITE_RAM

   IS_WRITE_DF00 -> DELAY_W_DF00 [ label="+3\n<\$DF00" ]
   DELAY_W_DF00 -> END_CLK_LOW [ label="+2" ]
   DELAY_W_DF00      [ label="@18 +8\ndelay" ]

   PUT_DATA_ON_BUS   [ label="@20 +8\nread memory\nput data on bus\nR0 updated\n@ <= 30" ]
   PUT_DATA_ON_BUS -> END_CLK_LOW

   WRITE_RAM         [ label="@25 +1\nwrite ram" ]
   WRITE_RAM -> END_CLK_LOW [ label="+2" ]

   FIFO_FOR_READ     [ label="@19 +1\nmark fifo trigger\nR6=0" ]
   FIFO_FOR_READ -> PUT_DATA_ON_BUS [ label="+2" ]

   END_CLK_LOW       [ label="@28" ]
   END_CLK_LOW -> LOOP_BACK

   LOOP_BACK         [ label="+2\nloop" ]
   LOOP_BACK -> PREPARE_RDY_CHECK

   { rank=same; INIT; LOOP_START; SELECT_RAM; REG_5MEM; }
   { rank=same; GET_BUS_STATE; REG_0GPIO; }
   { rank=same; PUT_DATA_ON_BUS; DELAY_R_D000; DELAY_R_0004; DELAY_W_DF00; }
   { rank=same; DELAY_W__DF00; BANKSWITCH; }
   { rank=same; DELAY_W_D000; DELAY_W_DF00; FIFO_FOR_WRITE; }
   { rank=same; IS_READ_DF00; IS_WRITE_D000; }
   { rank=same; IS_READ_DF10; IS_READ_D000; }
   { rank=same; NO_LOG; COUNTER_LOG; }
}
EOF
